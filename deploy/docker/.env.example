# Compose port and bind address. Keep loopback binding unless an external proxy is configured.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8000

# 默认从本地源码构建；发布部署时可改为 GHCR 中验收过的版本 Tag。
GATEWAY_IMAGE=microinfer-gateway:local

# The Gateway process runs as this UID/GID inside the container.
GATEWAY_UID=10001
GATEWAY_GID=10001

# Replace with a base64url-encoded random value containing at least 32 bytes.
GATEWAY_SESSION_HMAC_KEYS=REPLACE_WITH_RANDOM_BASE64URL_KEY
